{
  "name": "gitgud",
  "version": "2.12.0",
  "description": "Get Gud at Git",
  "homepage": "https://github.com/zeuros/gitgud",
  "author": {
    "name": "zeuros"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "version": "bash scripts/version.sh",
    "start": "npm run tauri:dev",
    "ng:serve": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve -c dev --port 4201",
    "build:angular": "ng build --base-href ./",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:linux-deb": "tauri build --bundles deb",
    "tauri:build:linux-rpm": "tauri build --bundles rpm",
    "tauri:build:win": "tauri build --bundles nsis",
    "tauri:build:mac": "tauri build --bundles dmg",
    "test": "vitest run",
    "lint": "ng lint",
    "test:watch": "vitest",
    "e2e:setup": "bash e2e/utils/setup-repo.sh",
    "e2e": "npm run e2e:setup && xvfb-maybe -- wdio run wdio.conf.ts",
    "e2e:debug": "npm run e2e:setup && WDIO_DEBUG=1 wdio run wdio.conf.ts --logLevel debug",
    "video": "bash e2e/record.sh"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@mismerge/core": "^1.2.1",
    "@ngx-translate/core": "18.0.0",
    "@primeuix/themes": "^3.0.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "font-awesome": "4.7.0",
    "identicon.js": "^2.3.3",
    "lodash-es": "^4.18.1",
    "monaco-editor": "^0.57.0",
    "node-interval-tree": "2.1.2",
    "primeflex": "^4.0.0",
    "primeicons": "8.0.2",
    "primeng": "^22.1.2",
    "rxjs": "7.8.2",
    "shiki": "^4.5.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@crabnebula/tauri-driver": "^2.0.9",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/identicon.js": "^2.3.5",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.6.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "webdriverio": "^9.32.0",
    "xvfb-maybe": "^0.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
