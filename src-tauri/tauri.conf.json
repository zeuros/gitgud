{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGud",
  "version": "2.11.0",
  "identifier": "com.gitgud.app",
  "build": {
    "beforeDevCommand": "npm run ng:serve",
    "devUrl": "http://localhost:4201",
    "beforeBuildCommand": "npm run build:angular",
    "frontendDist": "../dist/gitgud"
  },
  "app": {
    "windows": [
      {
        "title": "GitGud",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "backgroundColor": "#1c1e23"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "zeuros",
    "copyright": "Copyright (C) 2026 zeuros",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/zeuros/gitgud",
    "category": "DeveloperTool",
    "shortDescription": "Fast, native Git GUI client",
    "longDescription": "GitGud is a fast, native Git GUI with a visual branch graph, Monaco-powered diffs, interactive staging and rebase, stash, tag and remote management.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/io.github.zeuros.gitgud.metainfo.xml": "linux/io.github.zeuros.gitgud.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/io.github.zeuros.gitgud.metainfo.xml": "linux/io.github.zeuros.gitgud.metainfo.xml"
        }
      }
    }
  }
}
